# Local peer acceptance only. Do not use these demo passwords on a public server.
PLATFORM_WEB_PORT=5177
CLOUD_DISK_PORT=8082
PLATFORM_AUTH_USER=local
PLATFORM_AUTH_PASSWORD=local-demo-password-change-me
ACCEPTANCE_POSTGRES_PASSWORD=pulse-local-test
CLOUD_DISK_DB_PASSWORD=cloud-disk-local-test
CLOUD_DISK_MQ_PASSWORD=cloud-mq-local-test
# Add exact model hosts/URLs here before testing real models (comma-separated).
PLATFORM_ALLOWED_TARGETS=http://cloud-disk:8082
# Optional cloud document summarization; core smoke does not call it.
CLOUD_DISK_AI_API_KEY=
# Default: cloud-disk cloned beside ai-api-test-platform-v2. Override with an absolute path if needed.
# CLOUD_DISK_SOURCE=/absolute/path/to/cloud-disk
